<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
    IgnorableNamespaces="uap rescap desktop2">

    <Identity
        Name="4663Ostronggames.Spieglein"
        Publisher="CN=654B9AD8-3E71-4D00-B420-E162C13CD666"
        Version="1.0.5.0"
        ProcessorArchitecture="x64" />

    <Properties>
        <DisplayName>Spieglein</DisplayName>
        <PublisherDisplayName>Ostrong Studios</PublisherDisplayName>
        <Logo>Assets\StoreLogo.png</Logo>
    </Properties>

    <Dependencies>
        <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
    </Dependencies>

    <!-- Muss zu den Ordnern unter src/AirPlayReceiver.App/Strings/ passen.
         Neue Sprache: Ordner anlegen + hier eine Zeile ergaenzen. -->
    <Resources>
        <Resource Language="en-US" />
        <Resource Language="de-DE" />
        <Resource Language="es-ES" />
        <Resource Language="fr-FR" />
        <Resource Language="pt-BR" />
        <Resource Language="zh-Hans" />
    </Resources>

    <Applications>
        <Application Id="App" Executable="AirPlayReceiver.App.exe" EntryPoint="$targetentrypoint$">
            <uap:VisualElements
                DisplayName="Spieglein"
                Description="Mirror your iPhone, iPad or Mac to Windows. Not affiliated with Apple Inc."
                BackgroundColor="transparent"
                Square150x150Logo="Assets\Square150x150Logo.png"
                Square44x44Logo="Assets\Square44x44Logo.png">
                <uap:DefaultTile
                    ShortName="Spieglein"
                    Wide310x150Logo="Assets\Wide310x150Logo.png"
                    Square310x310Logo="Assets\LargeTile.png"
                    Square71x71Logo="Assets\SmallTile.png">
                    <uap:ShowNameOnTiles>
                        <uap:ShowOn Tile="square150x150Logo" />
                        <uap:ShowOn Tile="wide310x150Logo" />
                        <uap:ShowOn Tile="square310x310Logo" />
                    </uap:ShowNameOnTiles>
                </uap:DefaultTile>
                <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0A0A0A" />
            </uap:VisualElements>
        </Application>
    </Applications>

    <!--
      Firewall-Regeln fuer die beiden Kindprozesse.

      Warum das hier stehen MUSS: Den listen()-Aufruf machen uxplay.exe und
      mDNSResponder.exe, nicht AirPlayReceiver.App.exe. Ohne diese Deklaration
      fragt Windows den Nutzer nach zwei ihm voellig unbekannten EXE-Dateien aus
      C:\Program Files\WindowsApps\... — oder gar nicht. Und laut Microsoft gilt:
      ist der Nutzer kein lokaler Admin, erzeugt der Dialog eine BLOCK-Regel,
      egal welche Schaltflaeche er anklickt, und erscheint danach nie wieder.
      Die App waere auf dem Rechner dauerhaft und lautlos kaputt.

      Regeln aus dem Manifest legt die MSIX-Deployment-Engine beim Installieren
      als SYSTEM an: kein UAC, kein Dialog, keine Adminrechte noetig. Sie werden
      bei Deinstallation wieder entfernt.

      Die Ports muessen zu UxPlayController.BuildArguments() passen — dort sorgt
      das Argument "-p" dafuer, dass uxplay genau diese festen Ports belegt statt
      zufaelliger. Ohne "-p" greift keine dieser Regeln.
    -->
    <Extensions>
        <desktop2:Extension Category="windows.firewallRules">
            <desktop2:FirewallRules Executable="uxplay\uxplay.exe">
                <!-- AirPlay/RTSP-Steuerung -->
                <desktop2:Rule Direction="in" IPProtocol="TCP" LocalPortMin="7000" LocalPortMax="7001" Profile="all" />
                <desktop2:Rule Direction="in" IPProtocol="TCP" LocalPortMin="7100" LocalPortMax="7100" Profile="all" />
                <!-- RTP Audio/Video -->
                <desktop2:Rule Direction="in" IPProtocol="UDP" LocalPortMin="6000" LocalPortMax="6001" Profile="all" />
                <desktop2:Rule Direction="in" IPProtocol="UDP" LocalPortMin="7011" LocalPortMax="7011" Profile="all" />
            </desktop2:FirewallRules>
        </desktop2:Extension>
        <desktop2:Extension Category="windows.firewallRules">
            <desktop2:FirewallRules Executable="uxplay\mDNSResponder.exe">
                <!-- Bonjour/mDNS-Discovery — ohne das findet kein iPhone den PC -->
                <desktop2:Rule Direction="in" IPProtocol="UDP" LocalPortMin="5353" LocalPortMax="5353" Profile="all" />
            </desktop2:FirewallRules>
        </desktop2:Extension>
    </Extensions>

    <!--
      runFullTrust: erlaubt uns, uxplay.exe + mDNSResponder.exe als Child-Prozesse
      zu starten und an UDP/TCP-Ports zu lauschen (AirPlay 7000/7001/7100,
      RAOP UDP 6000/6001/7011, mDNS UDP 5353).
      Diese Capability ist "restricted" — beim Store-Submit musst du im Partner
      Center kurz begruenden ("native receiver fuer das AirPlay-Protokoll").
    -->
    <Capabilities>
        <rescap:Capability Name="runFullTrust" />
    </Capabilities>

</Package>
